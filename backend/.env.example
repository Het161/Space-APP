# Copy to .env for local development. Never commit the real file.

# Comma-separated CORS allowlist. Add your Vercel URL when you deploy.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Climatology window. 1996–2025 is exactly 30 full calendar years.
# NASA POWER has data back to 1981-01-01 if you want a longer baseline.
POWER_START_YEAR=1996
POWER_END_YEAR=2025

# Grid-cell cache. Each entry is ~11k days x 8 parameters; 50 entries keeps the
# service well inside Render's 512 MB free tier.
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=50

# Per-IP rate limit applied to /api/v1/*.
RATE_LIMIT=60/minute

# Verbose logging.
DEBUG=false
